/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer */

/** @var \GLSCroatia\Shipping\ViewModel\ParcelStatus $viewModel */
$viewModel = $block->getData('view_model');

$result = $viewModel->getParcelListStatuses();
?>

<div class="page tracking">
    <?php if ($result && $parcelList = $result->getData('parcel_list')): ?>
        <?php foreach ($parcelList as $parcel): ?>
            <div class="order subtitle caption">
                <?= $escaper->escapeHtml(__('Parcel Number')) ?>: <?= $escaper->escapeHtml($parcel['ParcelNumber'] ?? '') ?>
            </div>
            <div class="table-wrapper">
                <table class="data table order tracking">
                    <?php if ($clientNumber = $parcel['ClientNumber'] ?? ''): ?>
                        <tr>
                            <th class="col label" scope="row"><?= $escaper->escapeHtml(__('Client ID')) ?>:</th>
                            <td class="col value"><?= $escaper->escapeHtml($clientNumber) ?></td>
                        </tr>
                    <?php endif; ?>
                    <?php if ($clientReference = $parcel['ClientReference'] ?? ''): ?>
                        <tr>
                            <th class="col label" scope="row"><?= $escaper->escapeHtml(__('Client Reference')) ?>:</th>
                            <td class="col value"><?= $escaper->escapeHtml($clientReference) ?></td>
                        </tr>
                    <?php endif; ?>
                    <?php if ($deliveryCountryCode = $parcel['DeliveryCountryCode'] ?? ''): ?>
                        <tr>
                            <th class="col label" scope="row"><?= $escaper->escapeHtml(__('Delivery Country Code')) ?>:</th>
                            <td class="col value"><?= $escaper->escapeHtml($deliveryCountryCode) ?></td>
                        </tr>
                    <?php endif; ?>
                    <?php if ($deliveryZipCode = $parcel['DeliveryZipCode'] ?? ''): ?>
                        <tr>
                            <th class="col label" scope="row"><?= $escaper->escapeHtml(__('Delivery Postcode')) ?>:</th>
                            <td class="col value"><?= $escaper->escapeHtml($deliveryZipCode) ?></td>
                        </tr>
                    <?php endif; ?>
                    <?php if ($parcelNumber = $parcel['ParcelNumber'] ?? ''): ?>
                        <tr>
                            <th class="col label" scope="row"><?= $escaper->escapeHtml(__('Parcel Number')) ?>:</th>
                            <td class="col value"><?= $escaper->escapeHtml($parcelNumber) ?></td>
                        </tr>
                    <?php endif; ?>
                    <?php if ($weight = $parcel['Weight'] ?? ''): ?>
                        <tr>
                            <th class="col label" scope="row"><?= $escaper->escapeHtml(__('Weight')) ?>:</th>
                            <td class="col value"><?= $escaper->escapeHtml($weight) ?></td>
                        </tr>
                    <?php endif; ?>
                </table>
                <?php if ($parcelStatusList = $parcel['ParcelStatusList'] ?? []): ?>
                    <table class="data table order tracking">
                        <thead>
                            <tr>
                                <th class="col" scope="col"><?= $escaper->escapeHtml(__('Date')) ?></th>
                                <th class="col" scope="col"><?= $escaper->escapeHtml(__('Depot City')) ?></th>
                                <th class="col" scope="col"><?= $escaper->escapeHtml(__('Depot Number')) ?></th>
                                <th class="col" scope="col"><?= $escaper->escapeHtml(__('Status Code')) ?></th>
                                <th class="col" scope="col"><?= $escaper->escapeHtml(__('Description')) ?></th>
                                <th class="col" scope="col"><?= $escaper->escapeHtml(__('Info')) ?></th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php foreach ($parcelStatusList as $parcelStatus): ?>
                                <tr>
                                    <td class="col">
                                        <?php if ($statusDate = $parcelStatus['StatusDate'] ?? ''): ?>
                                            <?= $escaper->escapeHtml($viewModel->formatDate($statusDate)) ?>
                                        <?php endif; ?>
                                    </td>
                                    <td class="col"><?= $escaper->escapeHtml($parcelStatus['DepotCity'] ?? '') ?></td>
                                    <td class="col"><?= $escaper->escapeHtml($parcelStatus['DepotNumber'] ?? '') ?></td>
                                    <td class="col"><?= $escaper->escapeHtml($parcelStatus['StatusCode'] ?? '') ?></td>
                                    <td class="col"><?= $escaper->escapeHtml($parcelStatus['StatusDescription'] ?? '') ?></td>
                                    <td class="col"><?= $escaper->escapeHtml($parcelStatus['StatusInfo'] ?? '') ?></td>
                                </tr>
                            <?php endforeach; ?>
                        </tbody>
                    </table>
                <?php else: ?>
                    <div class="message info empty">
                        <div><?= $escaper->escapeHtml(__('Parcel status history is not available.')) ?></div>
                    </div>
                <?php endif; ?>
            </div>
        <?php endforeach; ?>
    <?php else: ?>
        <div class="message info empty">
            <div><?= $escaper->escapeHtml(__('Parcel status is currently unavailable.')) ?></div>
        </div>
    <?php endif; ?>

    <div class="actions">
        <button type="button" title="<?= $escaper->escapeHtml(__('Close Window')) ?>" class="action close">
            <span><?= $escaper->escapeHtml(__('Close Window')) ?></span>
        </button>
        <?= /* @noEscape */ $secureRenderer->renderEventListenerAsTag(
            'onclick',
            "window.close(); window.opener.focus();",
            'button.action.close'
        ) ?>
    </div>
</div>

<?php $scriptString = <<<script
    require([
        'jquery'
    ], function (jQuery) {
        /* hide the close button when the content doesn't open in a modal window */
        if (window.opener === null || typeof window.opener === "undefined") {
            jQuery('.actions button.close').hide();
        }
    });
script;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $scriptString, false) ?>
